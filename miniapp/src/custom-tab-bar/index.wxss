.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(245,250,236,0), rgba(245,250,236,.96) 30%);
  pointer-events: none;
}

.tab-bar {
  height: 106rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 8rpx;
  overflow: hidden;
  border-radius: 58rpx;
  background: #10110f;
  box-shadow: 0 12rpx 34rpx rgba(15,16,14,.2);
  pointer-events: auto;
}

.tab-item {
  min-width: 0;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 47rpx;
  color: #8f918d;
}

.tab-item.active { background: #c7ff35; color: #11120e; }
.icon-slot { width: 46rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.tab-item > text { height: 25rpx; margin-top: 1rpx; font-size: 18rpx; font-weight: 750; line-height: 25rpx; }
.nav-icon { position: relative; width: 34rpx; height: 34rpx; color: inherit; }
.home-icon { width: 28rpx; height: 27rpx; margin-top: 5rpx; border: 5rpx solid currentColor; border-radius: 8rpx; }
.home-icon::before { content: ''; position: absolute; left: 1rpx; top: -10rpx; width: 19rpx; height: 19rpx; border-left: 5rpx solid currentColor; border-top: 5rpx solid currentColor; transform: rotate(45deg); }
.home-icon > view { display: none; }
.pin-icon { width: 27rpx; height: 32rpx; border-radius: 50% 50% 50% 5rpx; background: currentColor; transform: rotate(-45deg); }
.pin-icon > view { position: absolute; left: 8rpx; top: 8rpx; width: 11rpx; height: 11rpx; border-radius: 50%; background: #10110f; }
.tab-item.active .pin-icon > view { background: #c7ff35; }
.mine-icon { width: 34rpx; height: 34rpx; }
.mine-head { position: absolute; left: 10rpx; top: 0; width: 11rpx; height: 11rpx; border: 4rpx solid currentColor; border-radius: 50%; }
.mine-body { position: absolute; left: 2rpx; bottom: 0; width: 29rpx; height: 15rpx; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 20rpx 20rpx 0 0; }
.record-icon { width: 36rpx; height: 36rpx; border: 4rpx solid currentColor; border-radius: 9rpx; background: transparent; box-shadow: none; color: inherit; font-size: 31rpx; font-weight: 400; line-height: 31rpx; text-align: center; }
