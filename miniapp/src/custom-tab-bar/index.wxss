/* 奶油白胶囊 tabBar（V6 贴纸手帐）。
   图标为 ui-doodles/{compass,pin,face}.svg 烘焙色的 base64 data-URI，
   默认 #A79E8A / 选中 #3E9B6F 两套；源文件见 miniapp/src/ui-doodles/。 */
.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 12rpx 22rpx calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,251,243,0), rgba(255,251,243,.96) 30%);
  pointer-events: none;
}

.tab-bar {
  height: 106rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 8rpx;
  overflow: hidden;
  border-radius: 44rpx;
  border: 3rpx solid #EFE5D0;
  background: #FFFDF6;
  box-shadow: 0 12rpx 34rpx rgba(51,46,38,.08);
  pointer-events: auto;
}

.tab-item {
  min-width: 0;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  color: #A79E8A;
}

.tab-item.active { background: #E5F3EA; color: #2F7D58; }
.icon-slot { width: 46rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; }
.tab-item > text { height: 25rpx; margin-top: 1rpx; font-size: 18rpx; font-weight: 600; line-height: 25rpx; }
.tab-item.active > text { font-weight: 800; }

.tab-icon {
  width: 40rpx;
  height: 40rpx;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  background-position: center;
}
.tab-compass { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-compass { background-image: url("data:image/svg+xml;base64,"); }
.tab-pin { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-pin { background-image: url("data:image/svg+xml;base64,"); }
.tab-face { background-image: url("data:image/svg+xml;base64,"); }
.tab-item.active .tab-face { background-image: url("data:image/svg+xml;base64,"); }

.record-icon { width: 36rpx; height: 36rpx; border: 4rpx solid currentColor; border-radius: 9rpx; background: transparent; box-shadow: none; color: inherit; font-size: 31rpx; font-weight: 400; line-height: 31rpx; text-align: center; }
