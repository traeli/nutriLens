diff --git a/miniapp/src/utils/city-search.js b/miniapp/src/utils/city-search.js
new file mode 100644
index 0000000..ae2a450
--- /dev/null
+++ b/miniapp/src/utils/city-search.js
@@ -0,0 +1,55 @@
+import { pinyin } from 'pinyin-pro'
+
+function normalized(value) {
+  return String(value || '').trim().toLowerCase().replace(/[\s'-]+/g, '')
+}
+
+function isSubsequence(query, target) {
+  if (!query) return true
+  let queryIndex = 0
+  for (let index = 0; index < target.length && queryIndex < query.length; index++) {
+    if (target[index] === query[queryIndex]) queryIndex++
+  }
+  return queryIndex === query.length
+}
+
+export function citySearchMeta(city) {
+  const syllables = pinyin(String(city && city.name || ''), { toneType: 'none', type: 'array' })
+    .map(normalized)
+    .filter(Boolean)
+  const pinyinText = syllables.join('')
+  const initials = syllables.map(item => item[0]).join('')
+  const initial = (initials[0] || '#').toUpperCase()
+  return { city, pinyin: pinyinText, initials, initial: /^[A-Z]$/.test(initial) ? initial : '#' }
+}
+
+export function citySearchGroups(cities, query = '') {
+  const keyword = normalized(query)
+  const items = (Array.isArray(cities) ? cities : [])
+    .map(citySearchMeta)
+    .filter(item => {
+      if (!keyword) return true
+      const name = normalized(item.city.name)
+      const code = normalized(item.city.code)
+      return name.includes(keyword)
+        || code.includes(keyword)
+        || item.pinyin.includes(keyword)
+        || item.initials.includes(keyword)
+        || isSubsequence(keyword, item.pinyin)
+        || isSubsequence(keyword, item.initials)
+    })
+    .sort((left, right) => left.initial.localeCompare(right.initial)
+      || left.pinyin.localeCompare(right.pinyin)
+      || String(left.city.code || '').localeCompare(String(right.city.code || '')))
+
+  const groups = []
+  for (const item of items) {
+    let group = groups[groups.length - 1]
+    if (!group || group.initial !== item.initial) {
+      group = { initial: item.initial, items: [] }
+      groups.push(group)
+    }
+    group.items.push(item.city)
+  }
+  return groups
+}
diff --git a/miniapp/tests/city-search.test.mjs b/miniapp/tests/city-search.test.mjs
new file mode 100644
index 0000000..1b5c084
--- /dev/null
+++ b/miniapp/tests/city-search.test.mjs
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+
+import { citySearchGroups } from '../src/utils/city-search.js'
+
+const cities = [
+  { code: '310000', name: '上海' },
+  { code: '110000', name: '北京' },
+  { code: '500000', name: '重庆' },
+  { code: '610100', name: '西安' },
+  { code: '430100', name: '长沙' },
+  { code: '440100', name: '广州' },
+]
+
+test('cities are grouped and sorted by pinyin initial', () => {
+  const groups = citySearchGroups(cities)
+  assert.deepEqual(groups.map(group => group.initial), ['B', 'C', 'G', 'S', 'X'])
+  assert.deepEqual(groups.flatMap(group => group.items.map(city => city.name)), ['北京', '长沙', '重庆', '广州', '上海', '西安'])
+})
+
+test('fuzzy search supports Chinese, full pinyin and initials', () => {
+  assert.deepEqual(citySearchGroups(cities, '海').flatMap(group => group.items.map(city => city.name)), ['上海'])
+  assert.deepEqual(citySearchGroups(cities, 'chongq').flatMap(group => group.items.map(city => city.name)), ['重庆'])
+  assert.deepEqual(citySearchGroups(cities, 'cq').flatMap(group => group.items.map(city => city.name)), ['重庆'])
+  assert.deepEqual(citySearchGroups(cities, 'xa').flatMap(group => group.items.map(city => city.name)), ['西安'])
+})
