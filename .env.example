# Copy to .env for Docker Compose. Never commit real values.
POSTGRES_USER=nutrilens
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=nutrilens
DATABASE_DSN=postgres://nutrilens:replace-with-url-encoded-password@postgres:5432/nutrilens?sslmode=disable

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_HOURS=168
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_ASR_MODEL=qwen3-asr-flash
CORS_ALLOW_ORIGINS=
DATA_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
PUBLIC_BASE_URL=https://example.com/uploads

# Only required when starting the optional admin profile:
# docker compose --profile admin up -d
DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-password
